rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Koleksi Admins
    // Hanya admin yang terautentikasi yang dapat membaca atau menulis data admin
    match /admins/{adminId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
    }

    // 2. Koleksi Layanan (Services)
    // Publik dapat membaca daftar layanan aktif, hanya admin yang dapat mengubah harga & layanan
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Koleksi Pengaturan Toko (Settings)
    // Publik dapat membaca info toko, jam buka, dan ongkir; hanya admin yang dapat mengubah
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Koleksi Pesanan (Orders)
    // - Pelanggan dapat membuat pesanan baru
    // - Pelanggan dapat membaca pesanan berdasarkan nomor transaksi mereka
    // - Pelanggan dapat mengunggah bukti pembayaran (paymentProofUrl)
    // - Admin dapat membaca, mengubah status, menyesuaikan harga, dan membatalkan pesanan
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['transactionId', 'customerName', 'customerPhone', 'grandTotal', 'status'])
                    && request.resource.data.grandTotal >= 0;
      allow update: if isAdmin() || (
        // Pelanggan hanya boleh mengupdate bukti pembayaran
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl', 'paymentStatus', 'updatedAt'])
        && request.resource.data.paymentStatus == 'menunggu_verifikasi'
      );
      allow delete: if isAdmin();
    }

    // 5. Koleksi Pelanggan (Customers)
    // Pelanggan dicatat saat order; data lengkap hanya dapat diakses oleh admin
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 6. Koleksi Pembayaran (Payments)
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 7. Koleksi Transaksi Keuangan (Transactions)
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 8. Koleksi Antar-Jemput (Pickup Deliveries)
    match /pickup_deliveries/{pickupId} {
      allow read, write: if true;
    }
  }
}
